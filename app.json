{
  "expo": {
    "name": "Realys",
    "slug": "realys",
    "version": "0.5.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF8F1",
    "android": {
      "package": "com.realys.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#A8790A"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECORD_AUDIO",
        "INTERNET",
        "CALL_PHONE",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Realys usa sua biometria para confirmar que você é uma pessoa real."
        }
      ],
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Realys usa o microfone para ouvir quando você chama \"Realys\".",
          "speechRecognitionPermission": "O Realys reconhece sua voz para atender seus pedidos."
        }
      ],
      "expo-secure-store"
    ],
    "icon": "./assets/icon.png"
  }
}
