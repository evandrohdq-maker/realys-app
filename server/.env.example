# Configuração do servidor do Realys. O script deploy/setup-ubuntu.sh cria o .env sozinho.
NODE_ENV=production
PORT=8080
HOST=127.0.0.1
DATA_DIR=data

# Endereço público (https) do Realyz. Vai nos links de convite para chamada (ex.: https://api.realyz.com.br)
PUBLIC_URL=

# Segredo que assina os acessos. Gere com:  openssl rand -hex 32
JWT_SECRET=

# Administrador criado na primeira vez que o servidor sobe
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Fase de testes: depósito entra na hora, sem Pix de verdade. Mude para false quando ligar o pagamento real.
TEST_DEPOSITS=true
# Compras e pagamentos (comprar, pagar serviço, presentear, turbinar, depositar, sacar).
# Ficam BLOQUEADOS até você mudar para true e reiniciar (o app mostra "temporariamente bloqueado").
# Liberar só depois do Pix de verdade configurado (PIX_* abaixo) e testado.
COMPRAS_LIBERADAS=false

# Conta sem biometria aprovada fica só no perfil social: não compra, não contrata e não usa a carteira.
# Com NODE_ENV=production já vem ligado. Use false só para demonstração.
EXIGIR_BIOMETRIA=true
# Conferência do rosto nas ações (loja mudar pedido, saque, aceite de serviço). Precisa do serviço
# biométrico (BIOMETRIA_SERVICE_URL). Primeiro teste sem esse serviço: false (e EXIGIR_BIOMETRIA=false).
VERIFICACAO_FACIAL_ACOES=true

# Regras de dinheiro (em reais)
GIFT_FEE_PCT=10
GIFT_FEE_MIN=0
GIFT_MIN=5
GIFT_MAX=2000
LIVE_CONVERT_MIN=10
# Comissão sobre vendas: 0 na fase de testes. Tabela do Realys (src/taxas.js): Shop 10%, Food 11%.
ORDER_FEE_PCT=0
FOOD_FEE_PCT=0
# Taxa de proteção Realyz, paga pelo cliente uma vez por compra (R$).
PROTECTION_FEE=0.99
WITHDRAW_MIN=10

# Tamanho máximo de um arquivo enviado (fotos, vídeos, músicas), em MB
MAX_UPLOAD_MB=60

# Servidor de vídeo próprio (lives e chamadas). Deixe vazio até contratar a VPS de vídeo
# (ver deploy/video/LEIA-ME.md). O instalador do servidor de vídeo mostra os valores para colar aqui.
VIDEO_URL=
VIDEO_SECRET=
VIDEO_QUALITY=720p
TURN_URL=
TURN_SECRET=

# E-mail (código do e-mail institucional dos servidores públicos). Serviço Resend (resend.com).
RESEND_API_KEY=
EMAIL_FROM=Realys <nao-responda@seudominio.com.br>

# Consulta de médicos do CFM (webservice oficial, empresas: R$ 948/ano). Ver sistemas.cfm.org.br/listamedicos/informacoes
CFM_WS_URL=
CFM_WS_KEY=

# Consulta automática nos outros conselhos (CRP, CRMV, COREN, CRO, CREA) pelo Infosimples (pago por consulta).
INFOSIMPLES_TOKEN=
# Caminhos extras por conselho e UF, conferidos no painel do Infosimples. Ex.: {"CRO-SP":"cro-sp/cadastro"}
CONSELHO_PATHS=

# Moderação de imagens (nudez) — server/moderacao-ia/LEIA-ME.md. Vazio = desligada.
MODERACAO_URL=
LIVE_CHECK_SEC=20
LIVE_RTSP_BASE=rtsp://127.0.0.1:8554/
FFMPEG_PATH=ffmpeg

# ---------- Notas fiscais e impostos (src/fiscal, guia em fiscal-LEIA-ME.md) ----------
# Deixe FISCAL_ATIVO=false até ter CNPJ, certificado digital A1 e o contador conferir tudo abaixo.
FISCAL_ATIVO=false
# 2 = produção restrita (testes da Receita). Só mude para 1 depois que as notas de teste saírem certas.
FISCAL_AMBIENTE=2
FISCAL_CNPJ=
FISCAL_IM=
# Código IBGE da cidade da empresa (Passo Fundo = 4314100)
FISCAL_MUNICIPIO=4314100
# simples, presumido ou mei
FISCAL_REGIME=simples
# Anexo do Simples. Intermediação de negócios é Anexo V com fator R (LC 123, art. 18, § 5º-M):
# fatorR = o sistema escolhe III ou V pela folha. Ou fixe III ou V se o contador mandar.
FISCAL_ANEXO=fatorR
# R$ de folha de salários + pró-labore + encargos nos últimos 12 meses (para o fator R)
FISCAL_FOLHA_12M=0
# Alíquota de ISS da cidade (usada no Lucro Presumido e nas estimativas)
FISCAL_ISS_PCT=5
# Código de tributação nacional do serviço (10.05.01 = intermediação; o contador confirma)
FISCAL_CTRIBNAC=100501
FISCAL_CTRIBMUN=
FISCAL_NBS=
FISCAL_SERIE=1
# imediato (uma nota por taxa), diario ou mensal (uma nota por cliente no período)
FISCAL_AGRUPAR=imediato
# Certificado A1 convertido para PEM com deploy/certificado-fiscal.sh
FISCAL_CERT_PEM=data/fiscal/certificado.pem
FISCAL_KEY_PEM=data/fiscal/chave.pem
FISCAL_INTERVALO_MIN=5
# Custos fixos do mês em R$ (servidor, biometria, contador...), para o resumo de lucro
FISCAL_CUSTOS_MENSAIS=0
# R$ faturados pela empresa fora do Realys nos últimos 12 meses (base do Simples)
FISCAL_RBT12_INICIAL=0
# Reforma tributária: destacar CBS e IBS na nota (no Simples, só quando o contador mandar)
FISCAL_DESTACAR_IBS_CBS=false
# NF-e de produto das lojas por emissor parceiro (Focus NFe). Homologação: https://homologacao.focusnfe.com.br
NFE_PARCEIRO_URL=
NFE_PARCEIRO_TOKEN=

# Verificação facial de entregadores, motoboys e motoristas enquanto estão disponíveis (horas)
BIOMETRIA_PERIODIC_HOURS=6

# Pix de verdade (depósitos) pela conta Santander do Realyz. Lucro: transferir para a conta Nubank
# (Painel do administrador › Caixa mostra quanto é lucro e quanto é dinheiro dos usuários).
# Credenciais no Portal Developers do Santander (com o gerente de cash). Usa o certificado A1 da empresa
# (o mesmo das notas fiscais: bash deploy/certificado-fiscal.sh certificado.pfx). Confira lá os endereços de produção.
# Com o Pix ligado, desligue os depósitos de teste: TEST_DEPOSITS=false
PIX_PROVIDER=
PIX_CLIENT_ID=
PIX_CLIENT_SECRET=
PIX_CHAVE=
# PIX_BASE_URL=https://trust-pix.santander.com.br
# PIX_TOKEN_URL=https://trust-pix.santander.com.br/oauth/token
# PIX_API_PATH=/api/v1

# IA própria do Realyz (modelo aberto no servidor, gratuito). Instale com: bash deploy/ia.sh
# Vazio = IA leve (responde pela ficha da empresa e pelo catálogo, sem modelo).
IA_URL=
IA_MODEL=qwen2.5:3b

# Notificações com o app fechado (Firebase). Baixe a chave em: Console do Firebase › Configurações do
# projeto › Contas de serviço › Gerar nova chave privada. Guarde o arquivo só no servidor (nunca no GitHub):
#   /opt/realys/server/data/firebase-conta-servico.json   (permissão 600)
# Vazio = notificações desligadas (o resto funciona normal).
FIREBASE_SERVICE_ACCOUNT=
