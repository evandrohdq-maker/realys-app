# Configuração do servidor do Realys. O script deploy/setup-ubuntu.sh cria o .env sozinho.
NODE_ENV=production
PORT=8080
HOST=127.0.0.1
DATA_DIR=data

# Segredo que assina os acessos. Gere com:  openssl rand -hex 32
JWT_SECRET=

# Administrador criado na primeira vez que o servidor sobe
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Fase de testes: depósito entra na hora, sem Pix de verdade. Mude para false quando ligar o pagamento real.
TEST_DEPOSITS=true

# Regras de dinheiro (em reais)
GIFT_FEE_PCT=5
GIFT_FEE_MIN=0.5
GIFT_MIN=5
GIFT_MAX=2000
LIVE_CONVERT_MIN=10
ORDER_FEE_PCT=0
WITHDRAW_MIN=10

# Tamanho máximo de um arquivo enviado (fotos, vídeos, músicas), em MB
MAX_UPLOAD_MB=60

# Servidor de vídeo próprio (lives e chamadas). Deixe vazio até contratar a VPS de vídeo
# (ver deploy/video/LEIA-ME.md). O instalador do servidor de vídeo mostra os valores para colar aqui.
VIDEO_URL=
VIDEO_SECRET=
VIDEO_QUALITY=720p
TURN_URL=
TURN_SECRET=

# E-mail (código do e-mail institucional dos servidores públicos). Serviço Resend (resend.com).
RESEND_API_KEY=
EMAIL_FROM=Realys <nao-responda@seudominio.com.br>

# Consulta de médicos do CFM (webservice oficial, empresas: R$ 948/ano). Ver sistemas.cfm.org.br/listamedicos/informacoes
CFM_WS_URL=
CFM_WS_KEY=

# Consulta automática nos outros conselhos (CRP, CRMV, COREN, CRO, CREA) pelo Infosimples (pago por consulta).
INFOSIMPLES_TOKEN=
# Caminhos extras por conselho e UF, conferidos no painel do Infosimples. Ex.: {"CRO-SP":"cro-sp/cadastro"}
CONSELHO_PATHS=

# Moderação de imagens (nudez) — server/moderacao-ia/LEIA-ME.md. Vazio = desligada.
MODERACAO_URL=
LIVE_CHECK_SEC=20
LIVE_RTSP_BASE=rtsp://127.0.0.1:8554/
FFMPEG_PATH=ffmpeg
