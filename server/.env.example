# Configuração do servidor do Realys. O script deploy/setup-ubuntu.sh cria o .env sozinho.
NODE_ENV=production
PORT=8080
HOST=127.0.0.1
DATA_DIR=data

# Segredo que assina os acessos. Gere com:  openssl rand -hex 32
JWT_SECRET=

# Administrador criado na primeira vez que o servidor sobe
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Fase de testes: depósito entra na hora, sem Pix de verdade. Mude para false quando ligar o pagamento real.
TEST_DEPOSITS=true

# Regras de dinheiro (em reais)
GIFT_FEE_PCT=10
GIFT_FEE_MIN=0
GIFT_MIN=5
GIFT_MAX=2000
LIVE_CONVERT_MIN=10
ORDER_FEE_PCT=0
WITHDRAW_MIN=10

# Tamanho máximo de um arquivo enviado (fotos, vídeos, músicas), em MB
MAX_UPLOAD_MB=60

# Servidor de vídeo próprio (lives e chamadas). Deixe vazio até contratar a VPS de vídeo
# (ver deploy/video/LEIA-ME.md). O instalador do servidor de vídeo mostra os valores para colar aqui.
VIDEO_URL=
VIDEO_SECRET=
VIDEO_QUALITY=720p
TURN_URL=
TURN_SECRET=

# E-mail (código do e-mail institucional dos servidores públicos). Serviço Resend (resend.com).
RESEND_API_KEY=
EMAIL_FROM=Realys <nao-responda@seudominio.com.br>

# Consulta de médicos do CFM (webservice oficial, empresas: R$ 948/ano). Ver sistemas.cfm.org.br/listamedicos/informacoes
CFM_WS_URL=
CFM_WS_KEY=

# Consulta automática nos outros conselhos (CRP, CRMV, COREN, CRO, CREA) pelo Infosimples (pago por consulta).
INFOSIMPLES_TOKEN=
# Caminhos extras por conselho e UF, conferidos no painel do Infosimples. Ex.: {"CRO-SP":"cro-sp/cadastro"}
CONSELHO_PATHS=

# Moderação de imagens (nudez) — server/moderacao-ia/LEIA-ME.md. Vazio = desligada.
MODERACAO_URL=
LIVE_CHECK_SEC=20
LIVE_RTSP_BASE=rtsp://127.0.0.1:8554/
FFMPEG_PATH=ffmpeg

# ---------- Notas fiscais e impostos (src/fiscal, guia em fiscal-LEIA-ME.md) ----------
# Deixe FISCAL_ATIVO=false até ter CNPJ, certificado digital A1 e o contador conferir tudo abaixo.
FISCAL_ATIVO=false
# 2 = produção restrita (testes da Receita). Só mude para 1 depois que as notas de teste saírem certas.
FISCAL_AMBIENTE=2
FISCAL_CNPJ=
FISCAL_IM=
# Código IBGE da cidade da empresa (Passo Fundo = 4314100)
FISCAL_MUNICIPIO=4314100
# simples, presumido ou mei
FISCAL_REGIME=simples
# Anexo do Simples. Intermediação de negócios é Anexo V com fator R (LC 123, art. 18, § 5º-M):
# fatorR = o sistema escolhe III ou V pela folha. Ou fixe III ou V se o contador mandar.
FISCAL_ANEXO=fatorR
# R$ de folha de salários + pró-labore + encargos nos últimos 12 meses (para o fator R)
FISCAL_FOLHA_12M=0
# Alíquota de ISS da cidade (usada no Lucro Presumido e nas estimativas)
FISCAL_ISS_PCT=5
# Código de tributação nacional do serviço (10.05.01 = intermediação; o contador confirma)
FISCAL_CTRIBNAC=100501
FISCAL_CTRIBMUN=
FISCAL_NBS=
FISCAL_SERIE=1
# imediato (uma nota por taxa), diario ou mensal (uma nota por cliente no período)
FISCAL_AGRUPAR=imediato
# Certificado A1 convertido para PEM com deploy/certificado-fiscal.sh
FISCAL_CERT_PEM=data/fiscal/certificado.pem
FISCAL_KEY_PEM=data/fiscal/chave.pem
FISCAL_INTERVALO_MIN=5
# Custos fixos do mês em R$ (servidor, biometria, contador...), para o resumo de lucro
FISCAL_CUSTOS_MENSAIS=0
# R$ faturados pela empresa fora do Realys nos últimos 12 meses (base do Simples)
FISCAL_RBT12_INICIAL=0
# Reforma tributária: destacar CBS e IBS na nota (no Simples, só quando o contador mandar)
FISCAL_DESTACAR_IBS_CBS=false
# NF-e de produto das lojas por emissor parceiro (Focus NFe). Homologação: https://homologacao.focusnfe.com.br
NFE_PARCEIRO_URL=
NFE_PARCEIRO_TOKEN=
